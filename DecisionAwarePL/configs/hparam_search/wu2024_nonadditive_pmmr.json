{
  "study": {
    "name": "wu2024_nonadditive_pmmr_factual_rmse_optuna",
    "max_trials": 100,
    "direction": "minimize",
    "metric": "validation_factual_rmse"
  },
  "fixed": {
    "data.version": "wu2024_nonadditive",
    "data.structure_type": "single_peaked_heterogeneous",
    "data.nonadditive_confounding_gamma": 0.7,
    "data.n_train": 3000,
    "data.n_test": 1000,
    "mean_pmmr.method": "pseudo_outcomes",
    "mean_pmmr.use_treatment_grid": true,
    "mean_pmmr.treatment_grid_size": 51
  },
  "search": {
    "common": {},
    "per_model": {
      "pmmr": {
        "pmmr.ridge": {
          "type": "categorical",
          "choices":
          [0.0001, 0.0005, 0.001, 0.005, 0.01, 0.05, 0.1, 0.5, 1.0]
        },
        "pmmr.awx_scale": {
          "type": "categorical",
            "choices": [0.3 ,0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 3.0, 3.5, 4.0]
        },
        "pmmr.azx_scale": {
          "type": "categorical",
            "choices": [0.3, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0]
        }
      }
    }
  }
}

