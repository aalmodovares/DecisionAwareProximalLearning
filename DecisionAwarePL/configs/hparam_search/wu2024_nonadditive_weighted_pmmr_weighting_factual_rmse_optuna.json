{
  "study": {
    "name": "wu2024_nonadditive_weighted_pmmr_weighting_factual_rmse_optuna",
    "max_trials": 50,
    "direction": "minimize",
    "metric": "validation_factual_rmse"
  },
  "fixed": {
    "data.version": "wu2024_nonadditive",
    "data.structure_type": "single_peaked_heterogeneous",
    "data.nonadditive_confounding_gamma": 0.7,
    "data.n_train": 3000,
    "data.n_test": 1000,

    "pmmr.ridge": 0.05,
    "pmmr.awx_scale": 3.0,
    "pmmr.azx_scale": 1.5,

    "mean_pmmr.method": "pseudo_outcomes",
    "mean_pmmr.use_treatment_grid": true,
    "mean_pmmr.treatment_grid_size": 51
  },
  "search": {
    "common": {},
    "per_model": {
      "weighted_pmmr": {
        "weighting.lam": {
          "type": "logfloat",
          "low": 0.2,
          "high": 20.0
        },
        "weighting.tau": {
          "type": "logfloat",
          "low": 0.02,
          "high": 2.0
        },
        "weighting.n_rounds": {
          "type": "categorical",
          "choices": [2, 3, 4, 5]
        }
      }
    }
  }
}

